# Скопируй в .env и заполни (start-docker.bat сделает это сам)

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Gmail для писем верификации преподавателей (необязательно, App Password)
MAIL_USERNAME=
MAIL_PASSWORD=

# ngrok: authtoken и бесплатный постоянный адрес из https://dashboard.ngrok.com (Domains), адрес без https://
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
