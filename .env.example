# Скопируй в .env и заполни (start-docker.bat сделает это сам)

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Gmail для писем верификации преподавателей (необязательно, App Password)
MAIL_USERNAME=
MAIL_PASSWORD=

# ngrok: authtoken и бесплатный постоянный адрес из https://dashboard.ngrok.com (Domains), адрес без https://
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Пароли базы и очереди. start-docker.bat сам допишет сюда случайные, если их нет.
# Пароль базы применяется при её первом создании; start-docker.bat при каждом запуске
# приводит пароли в уже созданных базе и очереди к значениям из этого файла.
POSTGRES_USER=sapsr_user
POSTGRES_PASSWORD=
RABBITMQ_USER=rmq_user
RABBITMQ_PASSWORD=

# Адрес Ollama (решение 8). По умолчанию — Ollama на самом ноутбуке:
# SAPSR_LLM_BASE_URL=http://host.docker.internal:11434
# Модель и протокол очередей обработчика (worker-python/README.md):
# SAPSR_LLM_MODEL=qwen3.5:4b
# SAPSR_QUEUE_PROTOCOL=1
