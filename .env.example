# Скопируй в .env и заполни (start-docker.bat сделает это сам)

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Gmail для писем верификации преподавателей (необязательно, App Password)
MAIL_USERNAME=
MAIL_PASSWORD=

# ngrok: authtoken и бесплатный постоянный адрес из https://dashboard.ngrok.com (Domains), адрес без https://
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Пароли базы и очереди. start-docker.bat сам допишет сюда случайные, если их нет.
# Пароль базы применяется при её первом создании; start-docker.bat при каждом запуске
# приводит пароли в уже созданных базе и очереди к значениям из этого файла.
POSTGRES_USER=sapsr_user
POSTGRES_PASSWORD=
RABBITMQ_USER=rmq_user
RABBITMQ_PASSWORD=

# Адрес Ollama (решение 8). По умолчанию — Ollama на самом ноутбуке:
# SAPSR_LLM_BASE_URL=http://host.docker.internal:11434
# Модели обработчика (решение 13, worker-python/llm-models.yaml). Какая проверяет — выбирает администратор
# в приложении («Управление» → «Красная зона»), без перезапуска. Скачать: ollama pull qwen3.5:2b / qwen3.5:9b
# SAPSR_LLM_MODEL=qwen3.5:4b
# SAPSR_LLM_LIGHT_MODEL=qwen3.5:2b
# SAPSR_LLM_HEAVY_MODEL=qwen3.5:9b
#
# Облачная модель (решение 2) — Groq, gpt-oss-120b: бесплатный тариф без карты, запросы не хранятся
# и не идут на обучение. Включить — раскомментировать разрешение и ключ (ключ: https://console.groq.com/keys).
# Ключ остаётся здесь: бэкенд и приложение его не видят. ФИО, почта, телефоны и группы из текста убираются.
# SAPSR_LLM_ALLOW_CLOUD=1
# SAPSR_LLM_CLOUD_API_KEY=<ключ gsk_...>
# Короткие рассуждения — меньше токенов, проверка быстрее и укладывается в бесплатный лимит:
# SAPSR_LLM_CLOUD_EXTRA_BODY={"reasoning_effort": "low", "include_reasoning": false}
# Адрес и модель Groq подставляются сами; другой сервис с OpenAI-совместимым API — свои адрес, модель и ключ.
# Запасной вариант, если Groq недоступен, — Cloudflare Workers AI (10 000 «нейронов» в день бесплатно):
# SAPSR_LLM_CLOUD_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ID аккаунта>/ai/v1
# SAPSR_LLM_CLOUD_MODEL=@cf/openai/gpt-oss-120b
#
# «SAPSR снова работает» всем пользователям при запуске; false — не рассылать:
# SAPSR_STARTUP_NOTICE=true
#
# Протокол очередей обработчика (worker-python/README.md):
# 2 — две фазы результата (по умолчанию); 1 — одним сообщением, откат, если с фазами что-то не так:
# SAPSR_QUEUE_PROTOCOL=2
# Показ без модели — записанные ответы из test-fixtures/llm-replay (README, «Показ без модели»):
# SAPSR_LLM_MODE=replay
