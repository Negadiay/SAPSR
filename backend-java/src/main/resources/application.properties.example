spring.application.name=backend
server.port=8080

# Пароли — те же, что POSTGRES_PASSWORD и RABBITMQ_PASSWORD в .env. В Docker они приходят из .env переменными окружения.
spring.datasource.url=jdbc:postgresql://localhost:5433/sapsr_db
spring.datasource.username=sapsr_user
spring.datasource.password=ПАРОЛЬ_ИЗ_ENV

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
# Схему меняют только миграции Flyway (src/main/resources/db/migration); Hibernate её лишь сверяет.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

# Базы, созданные до Flyway старым init.sql, принимаются как версия 1 — см. config/FlywayConfig.java.

# Корень хранилища файлов работ. В Docker рабочая папка бэкенда /app/backend, так что это /app/storage —
# общий том с обработчиком. Файлы лежат под ключами вида 2026/10/<UUID>.pdf (docs/contracts/queue-v2.md).
sapsr.storage.root=../storage

# Предел размера работы и размеченного файла — 50 МБ, как обещает интерфейс. Без этих строк Spring
# принимает только 1 МБ, а Docker-образ бэкенда собирается именно из этого файла.
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=51MB

# Тайм-аут содержательной проверки (решение 5): работа уходит преподавателю после фазы content
# либо через это время после фазы format, с отчётом по оформлению. Величина не утверждена (задача 5.1).
sapsr.pipeline.content-timeout=5m
# Сторож: проверка началась, а фазы format нет дольше этого — работа получает FAILED (queue-v2.md, раздел 6).
sapsr.pipeline.stuck-timeout=15m

# Данные запуска Telegram старше этого не принимаются: перехваченная строка не действует вечно (Ж5, пункт 3).
sapsr.telegram.init-data-max-age=24h
# Адреса, с которых интерфейс ходит в API с другого источника, через запятую (Ж5, пункт 9).
# Мини-приложение открывается с того же адреса, что и API, поэтому по умолчанию — пусто.
sapsr.cors.allowed-origins=

# Telegram Bot
telegram.bot.token=ВАШ_ТОКЕН
# Сообщение «SAPSR снова работает» всем пользователям при каждом запуске — по умолчанию выключено.
sapsr.bot.startup-notice=false
bot.webapp.url=https://ВАШ_ПОЛЬЗОВАТЕЛЬ.github.io/SAPSR/

# RabbitMQ
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=rmq_user
spring.rabbitmq.password=ПАРОЛЬ_ИЗ_ENV
sapsr.rabbitmq.tasks-queue=pdf_tasks_queue
sapsr.rabbitmq.results-queue=pdf_results_queue
sapsr.rabbitmq.progress-queue=pdf_progress_queue

# Email (Gmail SMTP для верификации преподавателей)
# Используй App Password: Google Account -> Security -> 2FA -> App passwords
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_GMAIL@gmail.com
spring.mail.password=YOUR_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Допустимый домен для регистрации преподавателей.
# Оставить пустым чтобы принимать любой email (для тестирования).
sapsr.teacher.allowed-domain=@bsuir.by

logging.level.org.telegram=INFO
